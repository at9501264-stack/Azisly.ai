# ==============================================================================
# GD Arena — Environment Variables Configuration
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Get your Gemini API key from Google AI Studio:
#    https://aistudio.google.com/app/apikey
# 3. Get your Sarvam API subscription key from Sarvam AI Developer Portal:
#    https://dashboard.sarvam.ai/
# 4. Paste your keys below.
# 5. If keys are omitted or blank, GD Arena automatically falls back to its
#    deterministic scripted engine and browser Web Speech APIs without crashing.
# ==============================================================================

# Primary LLM: Groq (ultra-low latency, blazing fast responses)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Fallback LLM: Google Gemini (Never expose to client or git)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model identifier (Defaults to gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-2.0-flash, gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash

# Optional: Dedicated model for post-discussion qualitative report generation
# Defaults to GEMINI_MODEL or gemini-2.5-flash
REPORT_MODEL=gemini-2.5-flash

# Required for Sarvam AI Voices (bulbul:v3) and Realtime Streaming STT (saaras:v4)
# Pass your api-subscription-key from Sarvam AI
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: Voice Gateway port for streaming audio WebSocket (Defaults to 3001)
VOICE_GATEWAY_PORT=3001

# Optional: Public URL for Voice Gateway when deployed separately (e.g. voice-gw.gdarena.app:3001)
# NEXT_PUBLIC_VOICE_GATEWAY_URL=localhost:3001

# Optional: Comma-separated list of allowed hostnames for Voice Gateway CORS/Origin check
# Set to * to allow all origins in containerized environments
# ALLOWED_ORIGIN_HOSTS=localhost,127.0.0.1,gdarena.app
