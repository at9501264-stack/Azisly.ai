# ==============================================================================
# GD Arena — Environment Variables
# ==============================================================================
#
# 1. Copy this file:   cp .env.example .env.local
# 2. Fill in the keys you have. Every key is optional: whatever is missing,
#    GD Arena falls back gracefully (scripted demo panel, browser voices,
#    browser speech recognition) instead of crashing.
# 3. Never commit .env.local — it is git-ignored.
# ==============================================================================

# ------------------------------------------------------------------------------
# Panel replies (LLM)
# ------------------------------------------------------------------------------
# Primary: Groq — fastest replies (~0.5–2s per turn)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Fallback replies + post-session coaching report: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Model used for the coaching report (defaults to GEMINI_MODEL)
REPORT_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Panel voices (text-to-speech)
# ------------------------------------------------------------------------------
# Primary: Gnani Vachana (timbre-v3.0). Streams 24kHz PCM so a panelist starts
# speaking ~1s after their reply is ready. Get a key at https://app.gnani.ai
GNANI_API_KEY=your_gnani_api_key_here

# Backup voices: Sarvam AI (bulbul:v3). Also powers realtime speech-to-text via
# the voice gateway. Comma-separate several keys to rotate on quota errors.
SARVAM_API_KEY=your_sarvam_api_key_here
# SARVAM_API_KEYS=key_one,key_two

# ------------------------------------------------------------------------------
# Optional: Gemini Live speech-to-speech channel (off by default)
# ------------------------------------------------------------------------------
# When "true", panelists speak through the Gemini Live model instead of the
# reply + voice pipeline. Requires Live API quota on GEMINI_API_KEY; if the model
# fails or produces no audio within 8s, the room switches to the voices above.
NEXT_PUBLIC_ENABLE_LIVE_S2S=false
GEMINI_S2S_MODEL=gemini-3.8-live

# ------------------------------------------------------------------------------
# Voice gateway (WebSocket bridge for realtime speech, runs with `npm run dev`)
# ------------------------------------------------------------------------------
VOICE_GATEWAY_PORT=3001
# Public URL of the gateway when deployed separately, e.g. voice.example.com
# NEXT_PUBLIC_VOICE_GATEWAY_URL=localhost:3001
# Hostnames allowed to open gateway connections (* = any)
# ALLOWED_ORIGIN_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Development
# ------------------------------------------------------------------------------
# Extra hostnames allowed to open the dev server besides localhost, e.g. your
# LAN IP so you can test on a phone. Note: browsers only allow the microphone
# on localhost or HTTPS.
# ALLOWED_DEV_ORIGINS=192.168.1.20,127.0.0.1
